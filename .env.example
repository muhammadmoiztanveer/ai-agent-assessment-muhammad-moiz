# =============================================================================
# Agentic Search Intelligence System — configuration
# Copy to `.env` and adjust. Every key has a safe default; the system runs with
# ZERO credentials in the default DataForSEO "mock" mode.
# =============================================================================

# ------------------------------ LLM ------------------------------------------
# LLM_MODE selects the model provider:
#   auto   = use OpenAI if OPENAI_API_KEY is set, else a deterministic mock (DEFAULT)
#   openai = force the real OpenAI client (requires OPENAI_API_KEY)
#   mock   = force the deterministic mock client (no network, no key)
# The system runs end-to-end with zero credentials in "auto"/"mock".
LLM_MODE=auto
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=3

# --------------------------- DataForSEO --------------------------------------
# mock  = deterministic local fixtures, no network, no credentials (DEFAULT)
# live  = call the real DataForSEO API (requires login + password below)
# stub  = minimal static stub responses
DATAFORSEO_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# ----------------------- Timeouts & retries ----------------------------------
HTTP_CONNECT_TIMEOUT_S=5
HTTP_READ_TIMEOUT_S=20
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_S=30

# ------------------------------ Scoring --------------------------------------
# opportunity_score = W_VOL*volume_norm + W_DIFF*difficulty_ease + W_GAP*visibility_gap
# Weights must sum to 1.0. VOLUME_CAP normalizes search volume into [0,1].
OPP_WEIGHT_VOLUME=0.4
OPP_WEIGHT_DIFFICULTY=0.3
OPP_WEIGHT_GAP=0.3
OPP_VOLUME_CAP=10000

# -------------------------- Persistence / app --------------------------------
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false

# ------------------------------- Server --------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
